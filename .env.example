DATABASE_URL="postgresql://mdesk:mdesk_local_dev_only@localhost:5432/mdesk?schema=public"
SESSION_SECRET="replace-with-a-long-random-string"
APP_BASE_URL="http://localhost:3000"
FRONTEND_ORIGINS="http://localhost:3000"

# Supabase Auth is used for invited-user password verification and setup links.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""

# SMTP delivery for account setup and invitation emails.
SMTP_HOST="smtp.resend.com"
SMTP_PORT="587"
SMTP_USER="resend"
SMTP_PASSWORD=""
SMTP_FROM="M-DESK <no-reply@your-verified-domain.com>"

# HR module (moved from M-Desk_fe) — letterhead on generated letters (all three are required to generate letters)
HR_COMPANY_NAME="Manikstu Agro Private Limited"
HR_COMPANY_ADDRESS=""
HR_SIGNATORY=""
# HR email: "outbox" records and tracks messages without sending until a provider is chosen
HR_EMAIL_PROVIDER="outbox"
HR_EMAIL_FROM="hr@example.com"

# Power BI embedding (optional, moved from M-Desk_fe). Leave blank to show the built-in charts only.
POWERBI_TENANT_ID=""
POWERBI_CLIENT_ID=""
POWERBI_CLIENT_SECRET=""
POWERBI_WORKSPACE_ID=""
POWERBI_REPORT_ID=""
